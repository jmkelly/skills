{
  "version": 1,
  "codemetrics": {
    "rules": {
      "cyclomatic": ["error", { "max": 15 }],
      "cognitive":  ["error", { "max": 15 }],
      "nesting":    ["error", { "max": 4 }],
      "lcom4":      ["off",   { "max": 4 }],
      "coupling":   ["error", { "max": 40 }],
      "mi":         ["error", { "min": 20 }]
    },
    "failOn": { "severity": "high" },
    "exclude": ["**/Migrations/**", "**/*.Tests/**", "**/obj/**", "**/bin/**"]
  }
}